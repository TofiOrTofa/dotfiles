      ["C"] = function ()
        return {[[close]]};
      end,


      ["F"] = function ()
        return {[[toggle-fullscreen]]};
      end,

      ["J"] = function ()
        return {[[swap next]]};
      end,
      ["K"] = function ()
        return {[[swap previous]]};
      end,

      ["period"] = function ()
        return {
		[[send-layout-cmd luatile "scroll_next()"]],
