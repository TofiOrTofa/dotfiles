#!/usr/bin/env sh

export XDG_CURRENT_DESKTOP=river
export _JAVA_AWT_WM_NONREPARENTING=1

dbus-update-activation-environment --systemd \
  WAYLAND_DISPLAY \
  XDG_CURRENT_DESKTOP=river \
  MESA_LOADER_DRIVER_OVERRIDE \
  _JAVA_AWT_WM_NONREPARENTING
systemctl --user import-environment \
  DISPLAY \
  WAYLAND_DISPLAY \
  XDG_CURRENT_DESKTOP

# --- backroom ---

r_map='riverctl map -layout 0'
exit_mode='riverctl enter-mode normal'

m='Mod4'
s="Shift"
c="Control"
a="Alt"
__="None"

# --- Interface settiongs ---

riverctl border-width 1
riverctl border-color-focused 0x000000
riverctl border-color-unfocused 0xFFFFFF
riverctl background-color 0xffffff

riverctl set-repeat 50 300
riverctl keyboard-layout -options "grp:caps_toggle" us,ru
riverctl map-pointer normal Super BTN_LEFT move-view
riverctl map-pointer normal Super BTN_RIGHT resize-view


# --- Inputs settings ---
touchpad='pointer-1267-12533-ELAN2204:00_04F3:30F5_Touchpad'

riverctl input $touchpad accel-profile flat
riverctl input $touchpad natural-scroll enabled
riverctl input $touchpad pointer-accel 1.0
riverctl input $touchpad tap enabled


# --- Layouts ---

riverctl spawn river-luatile &
# riverctl spawn rivercarro &
# riverctl spawn rivertile &
riverctl default-layout luatile
riverctl default-attach-mode above

# --- autostart ---
killall -q yambar xwayland-satellite || true

riverctl spawn "yambar" &
riverctl spawn "xwayland-satellite :1" &


# --- mods ---

riverctl declare-mode screen_sleep
riverctl declare-mode search
riverctl declare-mode resize


# ----------------------------------------
# MODE: NORMAL
# ----------------------------------------
mn="$r_map normal"

# Модификатор: Control
$mn $c Down spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
$mn $c Up spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%+'

# Модификатор: Mod4
$mn $m 1 set-focused-tags 1
$mn $m 2 set-focused-tags 2
$mn $m 3 set-focused-tags 4
$mn $m 4 set-focused-tags 8
$mn $m 5 set-focused-tags 16
$mn $m 6 set-focused-tags 32
$mn $m 7 set-focused-tags 64
$mn $m 8 set-focused-tags 128
$mn $m 9 set-focused-tags 256
$mn $m B spawn window_add_tags
$mn $m D enter-mode search
$mn $m F toggle-float
$mn $m H zoom
$mn $m J focus-view next
$mn $m K focus-view previous
$mn $m R enter-mode resize
$mn $m T spawn 'env LANG=C.UTF-8 LCALL=C.UTF-8 foot'
$mn $m W spawn combining_tags
$mn $m comma spawn 'riverctl focus-view previous'\
' && riverctl send-layout-cmd luatile "scroll_prev()"'
$mn $m period spawn 'riverctl focus-view next'\
' && riverctl send-layout-cmd luatile "scroll_next()"'

# Модификатор: Mod4+Shift
$mn $m+$s 1 set-view-tags 1
$mn $m+$s 2 set-view-tags 2
$mn $m+$s 3 set-view-tags 4
$mn $m+$s 4 set-view-tags 8
$mn $m+$s 5 set-view-tags 16
$mn $m+$s 6 set-view-tags 32
$mn $m+$s 7 set-view-tags 64
$mn $m+$s 8 set-view-tags 128
$mn $m+$s 9 set-view-tags 256
$mn $m+$s C close
$mn $m+$s D enter-mode search
$mn $m+$s E exit
$mn $m+$s Escape spawn 'riverctl enter-mode screen_sleep'\
' && wlr-randr --output eDP-1 --off'
$mn $m+$s F toggle-fullscreen
$mn $m+$s H send-layout-cmd rivertile "main-count +1"
$mn $m+$s J swap next
$mn $m+$s K swap previous
$mn $m+$s L send-layout-cmd rivertile "main-count -1"
$mn $m+$s Print spawn \
  'grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%s).png'
$mn $m+$s Q close
$mn $m+$s R enter-mode resize
$mn $m+$s XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-'
$mn $m+$s XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
$mn $m+$s XF86AudioMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
$mn $m+$s XF86AudioRaiseVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 20%+'
$mn $m+$s XF86MonBrightnessDown spawn 'brightnessctl set -- -10%'
$mn $m+$s XF86MonBrightnessUp spawn 'brightnessctl set +20%'
$mn $m+$s comma spawn \
' riverctl send-layout-cmd luatile "scroll_prev()"'\
' && riverctl swap previous'
$mn $m+$s period spawn \
' riverctl send-layout-cmd luatile "scroll_next()"'\
' && riverctl swap next'
$mn $m+$s semicolon spawn command-center

# Модификатор: None
$mn $__ Print spawn \
  'grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%s).png'
$mn $__ XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
$mn $__ XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
$mn $__ XF86AudioMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
$mn $__ XF86AudioRaiseVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%+'
$mn $__ XF86MonBrightnessDown spawn 'brightnessctl set -- -5%'
$mn $__ XF86MonBrightnessUp spawn 'brightnessctl set +10%'

unset mn
# ----------------------------------------
# MODE: RESIZE
# ----------------------------------------
mn="$r_map resize"

# Модификатор: None
$mn $__ D enter-mode search
$mn $__ H send-layout-cmd rivertile "main-ratio -0.05"
$mn $__ L send-layout-cmd rivertile "main-ratio +0.05"
$mn $__ Print spawn \
  'grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%s).png'
$mn $__ Super_L enter-mode normal
$mn $__ XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
$mn $__ XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
$mn $__ XF86AudioMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
$mn $__ XF86AudioRaiseVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%+'
$mn $__ XF86MonBrightnessDown spawn 'brightnessctl set -- -5%'
$mn $__ XF86MonBrightnessUp spawn 'brightnessctl set +10%'

# Модификатор: Shift
$mn $s H send-layout-cmd rivertile "main-ratio -0.2"
$mn $s L send-layout-cmd rivertile "main-ratio +0.2"
$mn $s Print spawn \
  'grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%s).png'
$mn $s XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-'
$mn $s XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
$mn $s XF86AudioMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
$mn $s XF86AudioRaiseVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 20%+'
$mn $s XF86MonBrightnessDown spawn 'brightnessctl set -- -10%'
$mn $s XF86MonBrightnessUp spawn 'brightnessctl set +20%'

unset mn
# ----------------------------------------
# MODE: SCREEN_SLEEP
# ----------------------------------------
mn="$r_map screen_sleep"
wake_cmd="wlr-randr --output eDP-1 --on"

# Модификатор: Shift
$mn $s Escape spawn "$wake_cmd && $exit_mode"

unset mn wake_cmd key
# ----------------------------------------
# MODE: SEARCH
# ----------------------------------------
mn="$r_map search"

# Модификатор: None
$mn $__ D spawn "fuzzel & $exit_mode"
$mn $__ E spawn "wofi-emoji & $exit_mode"
$mn $__ Escape enter-mode normal
$mn $__ L spawn "layout-menu.river & $exit_mode"
$mn $__ Print spawn \
  'grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%s).png'
$mn $__ R enter-mode resize
$mn $__ Super_L enter-mode normal
$mn $__ XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
$mn $__ XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
$mn $__ XF86AudioMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
$mn $__ XF86AudioRaiseVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%+'
$mn $__ XF86MonBrightnessDown spawn 'brightnessctl set -- -5%'
$mn $__ XF86MonBrightnessUp spawn 'brightnessctl set +10%'

# Модификатор: Shift
$mn $s Print spawn \
  'grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%s).png'
$mn $s XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-'
$mn $s XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
$mn $s XF86AudioMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
$mn $s XF86AudioRaiseVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 20%+'
$mn $s XF86MonBrightnessDown spawn 'brightnessctl set -- -10%'
$mn $s XF86MonBrightnessUp spawn 'brightnessctl set +20%'
