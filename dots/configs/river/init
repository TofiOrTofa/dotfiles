#!/usr/bin/env bash

dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=river
systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP


# --- Interface settiongs ---
riverctl border-width 2
riverctl border-color-focused 0x93a1a1
riverctl border-color-unfocused 0x073642
riverctl set-repeat 50 300
riverctl keyboard-layout -options "grp:caps_toggle" us,ru
riverctl map-pointer normal Super BTN_LEFT move-view
riverctl map-pointer normal Super BTN_RIGHT resize-view


# --- Inputs settings ---

riverctl input "pointer-1267-12533-ELAN2204:00_04F3:30F5_Touchpad" accel-profile flat
riverctl input "pointer-1267-12533-ELAN2204:00_04F3:30F5_Touchpad" natural-scroll enabled
riverctl input "pointer-1267-12533-ELAN2204:00_04F3:30F5_Touchpad" pointer-accel 1.0
riverctl input "pointer-1267-12533-ELAN2204:00_04F3:30F5_Touchpad" tap enabled


# --- Layouts ---

riverctl spawn river-luatile &
riverctl spawn rivercarro &
riverctl spawn rivertile &
riverctl default-layout luatile

# --- autostart ---

riverctl spawn "waybar" &


# --- mods ---

riverctl declare-mode screen_sleep
riverctl declare-mode insert
riverctl declare-mode search
riverctl declare-mode resize


# ----------------------------------------
# РЕЖИМ: INSERT
# ----------------------------------------
# Модификатор: None
riverctl map -layout 0 insert None Print spawn 'grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%s).png'
riverctl map -layout 0 insert None Super_L enter-mode normal
riverctl map -layout 0 insert None XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
riverctl map -layout 0 insert None XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
riverctl map -layout 0 insert None XF86AudioMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
riverctl map -layout 0 insert None XF86AudioRaiseVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+'
riverctl map -layout 0 insert None XF86MonBrightnessDown spawn 'brightnessctl set -- -5%'
riverctl map -layout 0 insert None XF86MonBrightnessUp spawn 'brightnessctl set +5%'
# Модификатор: Shift
riverctl map -layout 0 insert Shift Print spawn 'grim ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%m-%s).png'
riverctl map -layout 0 insert Shift XF86AudioLowerVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 20%-'
riverctl map -layout 0 insert Shift XF86AudioMicMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'
riverctl map -layout 0 insert Shift XF86AudioMute spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'
riverctl map -layout 0 insert Shift XF86AudioRaiseVolume spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 20%+'
riverctl map -layout 0 insert Shift XF86MonBrightnessDown spawn 'brightnessctl set +20%'
riverctl map -layout 0 insert Shift XF86MonBrightnessUp spawn 'brightnessctl set +20%'

