

set $mod Mod4
set $alt Mod1
set $ctrl control

gaps outer 5
gaps inner 14

smart_gaps on

#################################
#                               #
#         переменные            #
#                               #
#################################

set $browser firefox
set $terminal foot
set $search_apps wofi

#функциональный ряд f
set $sun_up brightnessctl set 5%+
set $sun_down brightnessctl set 5%-
set $sun_max brightnessctl set 100%
set $sun_min brightnessctl set 0%
set $sun_mute ~/.config/sway/scripts/switch_screen.sh

set $button_sun_up XF86MonBrightnessUp
set $button_sun_down XF86MonBrightnessDown
set $button_sun_max Shift+$button_sun_up
set $button_sun_min Shift+$button_sun_down


set $vol_up pactl set-sink-volume \@DEFAULT_SINK@ +5%
set $vol_down pactl set-sink-volume \@DEFAULT_SINK@ -5%
set $vol_max pactl set-sink-volume \@DEFAULT_SINK@ +100%
set $vol_min pactl set-sink-volume \@DEFAULT_SINK@ 0%
set $vol_mute pactl set-sink-mute \@DEFAULT_SINK@ toggle
set $vol_app pavucontrol

set $media_pause playerctl -p playerctld pause
set $media_play playerctl -p playerctld play-pause
set $media_next playerctl -p playerctld next
set $media_prev playerctl -p playerctld previous

set $button_vol_up XF86AudioRaiseVolume
set $button_vol_down XF86AudioLowerVolume
set $button_vol_max Shift+$button_vol_up
set $button_vol_min Shift+$button_vol_down
set $button_vol_mute XF86AudioMute

set $button_pause_media XF86AudioPause
set $button_play_media XF86AudioPlay
set $button_next_media XF86AudioNext
set $button_prev_media XF86AudioPrev

set $mic_up pactl set-source-volume \@DEFAULT_SOURCE@ +5%
set $mic_down pactl set-source-volume \@DEFAULT_SOURCE@ -5%
set $mic_max pactl set-source-volume \@DEFAULT_SOURCE@ +100%
set $mic_min pactl set-source-volume \@DEFAULT_SOURCE@ 0%
set $mic_mute pactl set-source-mute \@DEFAULT_SOURCE@ toggle

set $button_mic_up $ctrl+$button_vol_up
set $button_mic_down $ctrl+$button_vol_down
set $button_mic_max $ctrl+Shift+$button_vol_up
set $button_mic_min $ctrl+Shift+$button_vol_down
set $button_mic_mute XF86AudioMicMute

set $button_screenshot Print
set $screenshot_app grim -g "$(slurp)" - | swappy -f -

set $ws1 workspace number "1"
set $ws2 workspace number "2"
set $ws3 workspace number "3"
set $ws4 workspace number "4"
set $ws5 workspace number "5"
set $ws6 workspace number "6"
set $ws7 workspace number "7"
set $ws8 workspace number "8"
set $ws9 workspace number "9"
set $ws10 workspace number "10"
set $ws11 workspace number "11"
set $ws12 workspace number "12"
set $ws13 workspace number "13"
set $ws14 workspace number "14"
set $ws15 workspace number "15"
set $ws16 workspace number "16"
set $ws17 workspace number "17"
set $ws18 workspace number "18"
set $ws19 workspace number "19"
set $ws0 workspace number "0"

######################
#   window rules     #
######################

#assign [app_id="firefox"] workspace number 1
#assign [app_id="chromium"] workspace number 1
#
#assign [app_id="codium"] workspace number 2
#
#assign [app_id="org.pulseaudio.pavucontrol"] workspace number 10
#assign [app_id="blueman-manager"] workspace number 10
for_window [app_id="codium"] border none
for_window [class="VSCodium"] border none


######################
#       other        #
######################

font pango:monospace bold 8
titlebar_border_thickness 1
titlebar_padding 1

output * bg /home/comu/.config/wallpaper/Mahiro.jpg fill 
# /home/comu/wallpapers/static/wallpaper4 fill

#bar {
#    swaybar_command waybar -c ~/.config/waybar/sway/config.jsonc
#}

default_border pixel 2

# smart_gaps inverse_outer
# smart_borders on
corner_radius 0
focus_wrapping on
# hide_edge_borders --i3 smart


shadows enable
default_border none

shadow_blur_radius 40
shadow_color #7FB4E677          # Тень активного окна (черная, 50% прозрачности)
shadow_inactive_color #00000007 # Тень неактивного окна (полностью прозрачная)

client.focused           #7FB4E6 #7FB4E6 #FFFFFF #7FB4E6
client.focused_inactive  #A8E4A0 #A8E4A0 #2E3440 #A8E4A0
client.unfocused         #F0C674 #F0C674 #F0C674 #F0C674
client.urgent            #BF616A #BF616A #ECEFF4 #BF616A

include ~/.config/sway/config.d/*
exec ~/.config/sway/scripts/autostart.lua
exec playerctld daemon
# exec sudo powertop --auto-tune
# render_awake_timeout 10

# Экспорт переменных для корректной работы окон и экранных порталов
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

