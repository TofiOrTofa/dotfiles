
syntax off
set number
set relativenumber
set autoindent
set noswapfile
set noshowmode
set termguicolors
set scrolloff=12   
set nottimeout
"set timeoutlen=3000
set showcmd

autocmd BufReadPost * if &readonly | setlocal nonumber norelativenumber | endif
set viminfo+=n~/.local/state/vim/viminfo

set splitbelow
set splitright

set laststatus=2 " Всегда показывать статус-бар
" Строка статуса: имя файла [флаги] | текущий локальный корень окна
set statusline=%f\ %m\ %r%=%{getcwd()}


" Запрещаем Vim запрашивать версию терминала
set t_RV=
" Отключаем обработку специфичных xterm-кодов от foot
set noxtermcodes



colorscheme nord
let g:airline_theme='nord'
set laststatus=2
let g:airline_powerline_fonts = 1


set clipboard^=unnamed,unnamedplus

"mappings

let g:NERDTreeWinPos = "right"
let NERDTreeShowHidden=1
let NERDTreeCustomOpenArgs = {'file': {'where': 't'}}


" --- бинды ---

let mapleader = "\<Space>"
" пробел - клавиша лидер

"  --- дерево файлов ---

nnoremap <leader>ff :NERDTreeToggle<CR>
nnoremap <leader>fr :NERDTreeFind<CR>

"  --- вкладки ---

nnoremap <leader>tn :tabnew <CR>    " Новая вкладка
nnoremap <leader>tc :tabclose <CR>  " Закрыть вкладку
nnoremap <leader>th :tabprevious <CR> " Предыдущая (влево)
nnoremap <leader>tl :tabnext <CR>     " Следующая (вправо)

"  --- Окна (Splits) ---

nnoremap <leader>wv :vsplit <CR> " Вертикальный сплит
nnoremap <leader>ws :split <CR>  " Горизонтальный сплит
nnoremap <leader>wc :close <CR>  " Закрыть окно

" Перемещение по окнам через Пробел + h,j,k,l
nnoremap <Leader>wh <C-w>h
nnoremap <Leader>wj <C-w>j
nnoremap <Leader>wk <C-w>k
nnoremap <Leader>wl <C-w>l


"  --- Терминал ---

nnoremap <leader>tt :vertical rightbelow terminal <CR>

" --- IDE бинды ---

" Показать список ошибок (Diagnostics)
nnoremap <silent><leader>le :<C-u>CocList diagnostics<cr>

" Переименовать переменную во всем проекте (Rename)
nmap <leader>rn <Plug>(coc-rename)

" Применить быстрый фикс (Quick Fix)
nmap <leader>qf <Plug>(coc-codeaction-cursor)

" Поиск файлов через встроенный fzf (если поставишь плагин fzf.vim)
nnoremap <leader>p :Files<CR>

" Поиск текста во всем проекте
nnoremap <leader>ps :Rg<CR>

" Форматирование кода вручную
xmap <leader>f  <Plug>(coc-format-selected)
nmap <leader>f  <Plug>(coc-format-selected)

nnoremap <silent><expr> <c-space> coc#refresh()
" Пробел + cd заменяет корень текущего окна на папку открытого файла
nnoremap <Leader>cd :lcd %:p:h<CR>:pwd<CR>
