#!/usr/bin/env lua

local json_to_table = require("cjson").decode
local user_json_configs = io.read("*all")

if not user_json_configs or user_json_configs == "" then
    io.stderr:write("ERROR: not json config")
    os.exit(1)
end

local success, configs = pcall(json_to_table, user_json_configs)
if not success then
    io.stderr:write("ERROR: not current json config")
    os.exit(1)
end

tools = {}
do
  function tools.sorted_keys(elements)
    local keys = {}
    for element, _ in pairs(elements) do
      table.insert(keys, element)
    end
    table.sort(keys)
    return keys
  end
end

local config_tools = {}
do
  function config_tools.process_binding(mode, modifier,
                                        key, actions)
    if type(actions) == "string" then
      actions = { actions }
    end
    if #actions == 1 then
      return string.format(
        "riverctl map -layout 0 %s %s %s %s\n",
        mode, modifier, key, actions[1]
      )
    end
    local macro_name = actions.name or string.format(
      "macro_%s_%s_%s",
      mode, modifier, key:gsub("[^%w]", "_")
    )
    local river_macros_path = "/tmp/river-macros"
    local macro_path = river_macros_path .. 
      "/" .. macro_name
    local commands = "riverctl " .. table.concat(actions, "\nriverctl ")
    return string.format([[
riverctl map -layout 0 %s %s %s spawn "river-macros %s"
if [ ! -f "%s" ]; then
  cat << 'EOF' > "%s"
#!/usr/bin/env sh
%s
EOF
  chmod +x "%s"
fi]],
      mode, modifier, key, macro_name,
      macro_path, macro_path,
      commands, macro_path
    )
  end
  do
    local function process_modifier(mode, modifier, mod_bindings, output)
      table.insert(output, "# Модификатор: " .. modifier .. "\n")
      for _, key in ipairs(tools.sorted_keys(mod_bindings)) do
        table.insert(output, config_tools.process_binding(
          mode, modifier, key, mod_bindings[key]
        ))
      end
    end
    local function process_mode(mode, mode_bindings, output)
      local line = string.rep("-", 40)
      table.insert(output, string.format(
        "\n# %s\n# MODE: %s\n# %s\n",
        line, mode:upper(), line
      ))
      for _, modifier in ipairs(tools.sorted_keys(mode_bindings)) do
        process_modifier(mode, modifier, mode_bindings[modifier], output)
      end
    end
    function config_tools.generate_binds_section(keybindings)
      local output = {}
      for _, mode in ipairs(tools.sorted_keys(keybindings)) do
        process_mode(mode, keybindings[mode], output)
      end
      return table.concat(output)
    end
  end
end



io.write[[
#!/usr/bin/env bash

dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP=river \
    MESA_LOADER_DRIVER_OVERRIDE \
    _JAVA_AWT_WM_NONREPARENTING

systemctl --user import-environment \
    DISPLAY \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP
[ ! -d "/tmp/river-macros" ] && mkdir -p "/tmp/river-macros"


# --- Interface settiongs ---

riverctl border-width 2
riverctl border-color-focused 0x93a1a1
riverctl border-color-unfocused 0x073642
riverctl set-repeat 50 300
riverctl keyboard-layout -options "grp:caps_toggle" us,ru
riverctl map-pointer normal Super BTN_LEFT move-view
riverctl map-pointer normal Super BTN_RIGHT resize-view


# --- Inputs settings ---
]]
for _, device_name in ipairs(tools.sorted_keys(configs.inputs)) do
  io.write "\n"
  local commands = tools.sorted_keys(configs.inputs[device_name])
  for _, command1 in ipairs(commands) do
    local command2 = configs.inputs[device_name][command1]
    io.write(string.format(
      'riverctl input "%s" %s %s%s',
      device_name, command1, command2, "\n"
    ))
  end
end
io.write[[


# --- Layouts ---

]]
for _, name in ipairs(tools.sorted_keys(configs.layouts)) do
  if name == "luatile" then name = "river-luatile" end
  io.write("riverctl spawn " .. name .. " &\n")
end
for name, value in pairs(configs.layouts) do
  if not value.default then break end
  io.write("riverctl default-layout " .. name)
end
io.write[[


# --- autostart ---

]]
for _, program_name in ipairs(configs.autostart) do
  io.write('riverctl spawn "' .. program_name .. '" &\n')
end
io.write "\n\n"
io.write[[
# --- mods ---

]]
for mode_name, _ in pairs(configs.keybindings) do
  if mode_name == "normal" then
    goto normal
  end
  local line = string.format(
    "riverctl declare-mode "
    .. mode_name .. "\n"
  )
  io.write(line)
  ::normal::
end
io.write "\n"
io.write(config_tools.generate_binds_section(configs.keybindings))
