		{
			"id": "UQQbFWrr",
			"type": "text",
			"x": 923.1020821442419,
			"y": 913.1729991020867,
			"width": 404.11968994140625,
			"height": 850,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b1F",
			"roundness": null,
			"seed": 941349428,
			"version": 1625,
			"versionNonce": 1383402389,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773061354820,
			"link": null,
			"locked": false,
			"text": "если нажата одна \"o\":\n  есть две настройки\n  1:\n    фокус переходит на другое\n    окно на рабочем столе\n    который стоит следующим по\n    счёту, позиция окна на которое\n    перейдёт фокус зависит от\n    настроек, и от позиции окна\n    на котором был фокус ранее\n    и включает insert mode\n    \n    если workspace будет пустым,\n    то на нём создастся терминал\n    и включится insert mode\n  2:\n    все рабочие столы идущие\n    дальше по счёту сдвигаются\n    на один вправо вместе со \n    своими окнами, после создаётся\n    рабочий стол справа от того\n    на котором вы нажали \"o\" и \n    открывается терминал и включается\n    insert mode\nесли зажата \"shift\":\n  есть две настройки\n  1:\n    всё противоположно первой\n    настройки нажатия одиночной \"o\"\n  2:\n    все workspaces включая действующий\n    сдвегаются на один вправо, на пустом\n    действующем запускается терминал\n    и включается insert mode",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "если нажата одна \"o\":\n  есть две настройки\n  1:\n    фокус переходит на другое\n    окно на рабочем столе\n    который стоит следующим по\n    счёту, позиция окна на которое\n    перейдёт фокус зависит от\n    настроек, и от позиции окна\n    на котором был фокус ранее\n    и включает insert mode\n    \n    если workspace будет пустым,\n    то на нём создастся терминал\n    и включится insert mode\n  2:\n    все рабочие столы идущие\n    дальше по счёту сдвигаются\n    на один вправо вместе со \n    своими окнами, после создаётся\n    рабочий стол справа от того\n    на котором вы нажали \"o\" и \n    открывается терминал и включается\n    insert mode\nесли зажата \"shift\":\n  есть две настройки\n  1:\n    всё противоположно первой\n    настройки нажатия одиночной \"o\"\n  2:\n    все workspaces включая действующий\n    сдвегаются на один вправо, на пустом\n    действующем запускается терминал\n    и включается insert mode",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
