			"updated": 1773061354820,
			"link": null,
			"locked": false,
			"text": "если нажата одна \"i\":\n  переходит в insert mode\n  в текущем окне\nесли зажата \"shift\":\n  перемещает фокус окна\n  влево и включает insert mode",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
