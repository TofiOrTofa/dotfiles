			"updated": 1773061354820,
			"link": null,
			"locked": false,
			"text": "layout toggle split:\n  если нажата одна \"t\":\n    открытие терминала\nlayout tabbed:\n  если нажата одна \"t\":\n    терминал открывается в\n    активной вкладке\n  если зажата \"shift\":\n    терминал открывается в\n    новой вкладке",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "layout toggle split:\n  если нажата одна \"t\":\n    открытие терминала\nlayout tabbed:\n  если нажата одна \"t\":\n    терминал открывается в\n    активной вкладке\n  если зажата \"shift\":\n    терминал открывается в\n    новой вкладке",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
