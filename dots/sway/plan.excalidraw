			"version": 1739,
			"versionNonce": 1388108501,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773061354820,
			"link": null,
			"locked": false,
			"text": "если нажата одна \"q\":\n  отправляет активное\n  окно в \"скрытые\"\nесли зажата \"shift\":\n  отправляет окно в область,\n  которая закрывает окно\n  после 10 действий\nесли зажата \"ctrl\":\n  окно полностью\n  закрывается(кроме трея)\nесли зажата \"ctrl\"+\"shift\":\n  закрывается вся программа",
			"fontSize": 16.264693393413076,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "если нажата одна \"q\":\n  отправляет активное\n  окно в \"скрытые\"\nесли зажата \"shift\":\n  отправляет окно в область,\n  которая закрывает окно\n  после 10 действий\nесли зажата \"ctrl\":\n  окно полностью\n  закрывается(кроме трея)\nесли зажата \"ctrl\"+\"shift\":\n  закрывается вся программа",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
